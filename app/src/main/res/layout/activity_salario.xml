<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margen_principal">

        <TextView
            android:id="@+id/tvTituloSalario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_salario"
            android:textSize="@dimen/texto_titulo"
            android:textStyle="bold"
            android:textColor="@color/fucsia_oscuro"
            android:gravity="center"
            android:layout_marginBottom="@dimen/margen_titulo" />

        <EditText
            android:id="@+id/etEmpleado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/nombre_empleado"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario"
            android:inputType="textPersonName"
            android:background="@drawable/campo_fondo"
            android:padding="12dp"
            android:layout_marginBottom="@dimen/margen_campo" />

        <EditText
            android:id="@+id/etSalario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/salario_base"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario"
            android:inputType="numberDecimal"
            android:background="@drawable/campo_fondo"
            android:padding="12dp"
            android:layout_marginBottom="@dimen/margen_resultado" />

        <Button
            android:id="@+id/btnCalcularSalario"
            android:layout_width="match_parent"
            android:layout_height="@dimen/altura_boton"
            android:text="@string/calcular"
            android:textColor="@color/blanco"
            android:background="@drawable/boton_fucsia"
            android:layout_marginBottom="@dimen/margen_resultado" />

        <TextView
            android:id="@+id/tvResultadoSalario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/texto_resultado"
            android:textColor="@color/texto_principal"
            android:background="@color/blanco"
            android:padding="16dp"
            android:layout_marginBottom="@dimen/margen_campo" />

        <TextView
            android:id="@+id/tvSalarioBruto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/texto_resultado"
            android:textColor="@color/salario_bruto"
            android:textStyle="bold"
            android:background="@color/blanco"
            android:padding="16dp"
            android:layout_marginBottom="@dimen/margen_campo" />

        <TextView
            android:id="@+id/tvSalarioNeto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/texto_resultado"
            android:textColor="@color/salario_neto"
            android:textStyle="bold"
            android:background="@color/blanco"
            android:padding="16dp"
            android:layout_marginBottom="@dimen/margen_resultado" />

        <Button
            android:id="@+id/btnRegresarSalario"
            android:layout_width="match_parent"
            android:layout_height="@dimen/altura_boton"
            android:text="@string/regresar"
            android:textColor="@color/blanco"
            android:background="@drawable/boton_fucsia" />

    </LinearLayout>

</ScrollView>